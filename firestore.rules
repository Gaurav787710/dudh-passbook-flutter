rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: check if user is a member of the dairy (admin or staff)
    // Admin (uid == dairyId) always passes without needing _members doc
    function isMember(dairyId) {
      return request.auth != null &&
        (request.auth.uid == dairyId ||
         (exists(/databases/$(database)/documents/_members/$(dairyId)) &&
          get(/databases/$(database)/documents/_members/$(dairyId)).data.uids.hasAny([request.auth.uid])));
    }
    
    // Users collection - authenticated users can read own doc, owner can write
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth.uid == userId;
    }
    
    // Dairies collection - PUBLIC read needed for login lookup by mobile,
    // Consider storing only non-sensitive fields here. Owner-only writes.
    match /dairies/{dairyId} {
      allow read: if true;
      allow write: if request.auth.uid == dairyId;
    }
    
    // Public lookups - public read for login, only dairy owner can write own entries
    match /public_lookups/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Members collection - dairy owner manages, members can read their own dairy's doc
    // Staff can self-add their own UID via arrayUnion (preserves existing UIDs)
    match /_members/{dairyId} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == dairyId;
      allow delete: if request.auth.uid == dairyId;
      allow update: if request.auth.uid == dairyId ||
        (request.auth != null &&
         request.resource.data.uids.hasAll(resource.data.uids) &&
         request.resource.data.uids.hasAny([request.auth.uid]));
    }
    
    // Staff collection - owner can CRUD, staff can read own doc
    match /staff/{staffId} {
      allow create: if request.auth != null && request.resource.data.dairyId == request.auth.uid;
      allow read: if request.auth != null && 
        (resource.data.dairyId == request.auth.uid || resource.data.firebaseAuthUid == request.auth.uid);
      allow update, delete: if request.auth != null && resource.data.dairyId == request.auth.uid;
    }
    
    // Farmers collection - only dairy members can read/write their dairy's farmers
    match /farmers/{farmerId} {
      allow read: if request.auth != null && isMember(resource.data.dairyId);
      allow create: if request.auth != null && isMember(request.resource.data.dairyId);
      allow update, delete: if request.auth != null && isMember(resource.data.dairyId);
    }
    
    // Milk entries collection - only dairy members can read/write
    match /milkEntries/{entryId} {
      allow read: if request.auth != null && isMember(resource.data.dairyId);
      allow create: if request.auth != null && isMember(request.resource.data.dairyId);
      allow update, delete: if request.auth != null && isMember(resource.data.dairyId);
    }
    
    // Payments collection - only dairy members can read/write
    match /payments/{paymentId} {
      allow read: if request.auth != null && isMember(resource.data.dairyId);
      allow create: if request.auth != null && isMember(request.resource.data.dairyId);
      allow update, delete: if request.auth != null && isMember(resource.data.dairyId);
    }
    
    // Advances collection - only dairy members can read/write
    match /advances/{advanceId} {
      allow read: if request.auth != null && isMember(resource.data.dairyId);
      allow create: if request.auth != null && isMember(request.resource.data.dairyId);
      allow update, delete: if request.auth != null && isMember(resource.data.dairyId);
    }
    
    // Rate charts collection - only dairy members can read/write
    match /rateCharts/{chartId} {
      allow read: if request.auth != null && isMember(resource.data.dairyId);
      allow create: if request.auth != null && isMember(request.resource.data.dairyId);
      allow update, delete: if request.auth != null && isMember(resource.data.dairyId);
    }
    
    // Dairy settings collection - members can read, only owner can write
    match /dairy_settings/{dairyId} {
      allow read: if request.auth != null && isMember(dairyId);
      allow write: if request.auth != null && request.auth.uid == dairyId;
    }
    
    // Default deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
